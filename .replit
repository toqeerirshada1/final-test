modules = ["nodejs-20", "web", "bash", "python-3.11"]

run = "nix develop --command bash -lc 'pnpm install && pnpm run start:all'"

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-permissions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin Panel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rider App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Vendor App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:admin"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:vendor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:rider"

[[workflows.workflow]]
name = "check-permissions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node artifacts/api-server/scripts/check-permissions.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "[ -s .env ] || bash scripts/bootstrap.sh && pnpm --filter @workspace/api-server dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Admin Panel"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "[ -s .env ] || bash scripts/bootstrap.sh && PORT=3000 BASE_PATH=/admin/ VITE_API_PROXY_TARGET=http://127.0.0.1:5000 pnpm --filter @workspace/admin dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Rider App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "[ -s .env ] || bash scripts/bootstrap.sh && PORT=3001 BASE_PATH=/rider/ VITE_API_PROXY_TARGET=http://127.0.0.1:5000 pnpm --filter @workspace/rider-app dev"
waitForPort = 3001

[[workflows.workflow]]
name = "Vendor App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "[ -s .env ] || bash scripts/bootstrap.sh && PORT=3002 BASE_PATH=/vendor/ VITE_API_PROXY_TARGET=http://127.0.0.1:5000 pnpm --filter @workspace/vendor-app dev"
waitForPort = 3002

[[workflows.workflow]]
name = "typecheck:api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/lib/db && pnpm build && cd /home/runner/workspace/lib/phone-utils && pnpm build && cd /home/runner/workspace/artifacts/api-server && pnpm tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck:admin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/admin && pnpm tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck:vendor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/vendor-app && pnpm tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck:rider"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/rider-app && pnpm tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 480000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "psmisc", "rustc", "tree", "uwhoisd"]

[userenv]

[userenv.shared]
ADMIN_SEED_USERNAME = "superadmin"
ADMIN_SEED_PASSWORD = "Admin@123"
ADMIN_SEED_NAME = "Super Admin"
PORT = "5000"
PORT_FALLBACK_ENABLE = "true"
PORT_MAX_RETRIES = "10"
LOG_LEVEL = "debug"
NODE_ENV = "development"
JWT_ISSUER = "ajkmart-dev"
GEMINI_API_KEY = ""
FIREBASE_PROJECT_ID = ""
FIREBASE_CLIENT_EMAIL = ""
FIREBASE_PRIVATE_KEY = ""
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM_NUMBER = ""
SENDGRID_API_KEY = ""
SMTP_HOST = ""
GOOGLE_MAPS_API_KEY = ""
OSRM_API_URL = ""
REDIS_URL = ""
SENTRY_DSN = ""
VAPID_PRIVATE_KEY = ""
VAPID_PUBLIC_KEY = ""
VAPID_CONTACT_EMAIL = ""
ALLOWED_ORIGINS = ""
VENDOR_DEV_PORT = "3002"
RIDER_DEV_PORT = "3001"
DATABASE_URL = "postgresql://neondb_owner:npg_8CZnNQxSivM4@ep-withered-pond-aod3mqmg-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
ADMIN_SEED_EMAIL = "admin@ajkmart.com"
APP_BASE_URL = "http://localhost:5000"
ADMIN_BASE_URL = "http://localhost:3000"
FRONTEND_URL = "http://localhost:3000,http://localhost:3001,http://localhost:3002"
CLIENT_URL = "http://localhost:3000"
EXPO_PUBLIC_DOMAIN = "localhost:5000"
VITE_API_BASE_URL = "http://localhost:5000"
ADMIN_LEGACY_AUTH_DISABLED = "0"
ADMIN_PASSWORD_RESET_TOKEN_TTL_MIN = "15"
ADMIN_DEV_PORT = "3000"

[userenv.production]

[userenv.development]
VITE_API_PROXY_TARGET = "http://127.0.0.1:5000"

[rules]

[rules.formatter]

[rules.formatter.fileExtensions]

[rules.formatter.fileExtensions.".ts"]
id = "module:nodejs-24/languageServer:typescript-language-server"

[[ports]]
localPort = 3000

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 21463
externalPort = 3002

[[ports]]
localPort = 22969
externalPort = 3003

[[ports]]
localPort = 23744
externalPort = 3000
